# Copy this file to .env.local and fill in real values.
# Get these from Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY — bypasses Row Level Security. Never expose to the client,
# never prefix with NEXT_PUBLIC_, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Session / auth
INACTIVITY_TIMEOUT_MINUTES=15

# Canonical site URL — used to build absolute links (e.g. the "Scan to
# Verify" QR code, which must resolve from any phone camera, not just from
# within the app). Set this to the real deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
